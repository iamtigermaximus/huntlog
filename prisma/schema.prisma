generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id                   String      @id @default(cuid())
  userId               String
  jobTitle             String
  company              String
  location             String?
  jobDescription       String      @db.Text
  jobUrl               String?
  salaryMin            Int?
  salaryMax            Int?
  jobType              String?
  seniorityLevel       String?
  appliedDate          DateTime    @default(now())
  jobPostingDate       DateTime?
  jobExpirationDate    DateTime?
  offerDeadline        DateTime?
  followUpDate         DateTime?
  lastUpdated          DateTime    @updatedAt
  status               Status      @default(WISHLIST)
  matchScore           Int?
  missingSkills        String?     @db.Text
  recommendations      String?     @db.Text
  strengths            String?     @db.Text
  notes                String?     @db.Text
  coverLetter          String?     @db.Text
  resumeId             String?
  confirmationReceived Boolean     @default(false)
  confirmationDate     DateTime?
  confirmationNotes    String?     @db.Text
  source               String?
  referralName         String?
  autoApplied          Boolean     @default(false)
  applicationPackage   Json?
  lastMonitoredAt      DateTime?
  monitoringNotes      String?     @db.Text
  followUpDraft        String?     @db.Text
  Resume               Resume?     @relation(fields: [resumeId], references: [id])
  User                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Interview            Interview[]

  @@index([appliedDate])
  @@index([confirmationReceived])
  @@index([jobExpirationDate])
  @@index([status])
  @@index([userId])
}

model Interview {
  id               String      @id @default(cuid())
  applicationId    String
  round            String
  scheduledDate    DateTime
  duration         Int?
  location         String?
  interviewerName  String?
  interviewerEmail String?
  notes            String?     @db.Text
  feedback         String?     @db.Text
  completed        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  Application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([scheduledDate])
}

model Resume {
  id          String        @id @default(cuid())
  userId      String
  name        String
  fileName    String
  content     String?       @db.Text
  fileUrl     String?
  isActive    Boolean       @default(false)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  lastUsed    DateTime?
  Application Application[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  resumes      Resume[]
}

enum Status {
  WISHLIST
  APPLIED
  REVIEWING
  PHONE_SCREEN
  TECHNICAL
  ONSITE
  OFFER
  NEGOTIATING
  ACCEPTED
  REJECTED
  GHOSTED
  ARCHIVED
}
